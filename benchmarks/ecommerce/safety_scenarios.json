    },
    {
      "id": "s-no-policy",
      "category": "permission violations",
      "expect_safe": false,
      "action": "runtime.delete"
    },
    {
      "id": "s-deny-policy",
      "category": "permission violations",
      "expect_safe": false,
      "action": "runtime.mutate"
    },
    {
      "id": "s-unsafe-sql",
      "category": "permission violations",
